---
// "Mais terra ou mais produtividade?": how much the harvested area, the yield and the
// production of each crop changed in Brazil, period by period, from the decomposition the
// data package publishes (analysis.json, growth_decomposition: the ends of each period are
// three-year means). Each change is end / start − 1 (the provenance operation `change`).
// The periods of about ten years are bars on one scale shared by every crop, from the same
// zero: what grew goes right, what shrank goes left. The whole period of each crop (soybean
// +1,493% from 1975 to 2024) would flatten every other bar, so it is written above its bars
// instead. The shares of each factor in the growth (the log decomposition) stay in the table
// of the figure. (Before: bars of the shares, abstract for a lay reader, and coffee's −96% and
// +196% flattened the scale.) Coffee starts in 2005, after the 2002 unit break. It is Figura
// 2 of the page (the map is Figura 1). Rendered at build time, so the page downloads nothing
// for it and it works without JavaScript; the browser renders it only near the screen.
import { scaleLinear } from "d3-scale";

import { dataBasePath, loadDataFile } from "../../lib/data";
import { format } from "../../lib/format";
import { sourced } from "../../lib/sourced";
import { bindShortWords } from "../../lib/typography";
import Num from "../Num.astro";
import Structural from "../Structural.astro";

type Column = (string | number | boolean | null)[];
const block = loadDataFile<{ growth_decomposition: Record<string, Column> }>("analysis.json")
  .growth_decomposition;
const TABLE = "analysis.json#/growth_decomposition";
const COLUMNS = [
  "start_anchor|year",
  "end_anchor|year",
  "start_production_t|int",
  "end_production_t|int",
  "start_harvested_area_ha|int",
  "end_harvested_area_ha|int",
  "area_share_of_growth|pct",
  "yield_share_of_growth|pct",
].join(",");

const CROPS = [
  { id: "soybean", name: "Soja" },
  { id: "corn", name: "Milho" },
  { id: "coffee_processed", name: "Café beneficiado" },
];
const at = (column: string, row: number) => block[column]?.[row];
const num = (column: string, row: number) => Number(at(column, row));
const rowsOf = (crop: string) =>
  (block.series ?? [])
    .map((series, row) => ({ series, row }))
    .filter(({ series, row }) => series === crop && at("territory_level", row) === "country")
    .map(({ row }) => row)
    .sort((a, b) => {
      // The whole period first (the widest), then the periods inside it, in order.
      const span = (r: number) => num("end_anchor", r) - num("start_anchor", r);
      return span(b) - span(a) || num("start_anchor", a) - num("start_anchor", b);
    });
const groups = CROPS.map((crop) => {
  const rows = rowsOf(crop.id);
  return { ...crop, whole: rows[0], parts: rows.slice(1) };
}).filter((g) => g.whole !== undefined);
if (groups.length === 0) throw new Error("no national growth decomposition in analysis.json");

// The three changes of a period, production first (the result), then its two factors.
const FACTORS = [
  { field: "production_t", name: "produção", key: "production" },
  { field: "harvested_area_ha", name: "área", key: "area" },
  { field: "yield_kg_ha", name: "produtividade", key: "yield" },
] as const;
const changeOf = (row: number, field: string) => num(`end_${field}`, row) / num(`start_${field}`, row) - 1;
const change = (row: number, field: string) =>
  sourced("analysis.json", `/growth_decomposition/start_${field}/${row}`, "spct", "change");
const year = (row: number, column: string) =>
  sourced("analysis.json", `/growth_decomposition/${column}/${row}`, "year");

// One scale for every bar of the periods inside the whole ones, always including zero.
const changes = groups.flatMap((g) => g.parts.flatMap((r) => FACTORS.map((f) => changeOf(r, f.field))));
const x = scaleLinear()
  .domain([Math.min(0, ...changes), Math.max(0, ...changes)])
  .range([0, 100]);
// Positions in % of the bars' column, to two decimals (finer than a pixel at any width).
const round = (v: number) => Math.round(v * 100) / 100;
/** A bar from zero to its change, and where its label goes: after the end of a bar that
 *  grows to the right, and just right of zero for one that goes left. */
const barOf = (row: number, field: string) => {
  const v = changeOf(row, field);
  return {
    left: round(x(Math.min(0, v))),
    width: round(x(Math.max(0, v)) - x(Math.min(0, v))),
    label: round(x(Math.max(0, v))),
  };
};

const byId = (crop: string) => groups.find((g) => g.id === crop);
// Which factor grew more in a period, as the lead says it (decided by the data).
const driver = (row: number) =>
  changeOf(row, "harvested_area_ha") > changeOf(row, "yield_kg_ha") ? "área" : "produtividade";
const soy = byId("soybean")?.whole;
const corn = byId("corn")?.whole;
const coffee = byId("coffee_processed")?.whole;
const breakYear = sourced("catalog.json", "/parameters/coffee_unit_break_year", "year");

// Coffee: production grew while the harvested area shrank. A note next to its bars says so,
// with the area at both ends of the whole period, and only while the published numbers say it.
const shrank = (r: number) =>
  changeOf(r, "production_t") > 0 && changeOf(r, "harvested_area_ha") < 0;
const coffeeGroup = byId("coffee_processed");
const coffeeNote =
  coffee !== undefined && shrank(coffee)
    ? {
        everyPeriod: [coffee, ...(coffeeGroup?.parts ?? [])].every(shrank),
        from: sourced("analysis.json", `/growth_decomposition/start_harvested_area_ha/${coffee}`, "int"),
        to: sourced("analysis.json", `/growth_decomposition/end_harvested_area_ha/${coffee}`, "int"),
      }
    : null;
---

<section class="growth" aria-labelledby="crescimento-titulo">
  <div class="growth__text">
    <h2 id="crescimento-titulo" class="growth__heading">
      {bindShortWords("Mais terra ou mais produtividade?")}
    </h2>
    {
      soy !== undefined && corn !== undefined && (
        <p class="growth__lead">
          De <Num n={year(soy, "start_anchor")} /> a <Num n={year(soy, "end_anchor")} />, a
          produção de soja cresceu mais pela {driver(soy)}, e a de milho, mais pela {driver(corn)}.
          {coffee !== undefined && shrank(coffee) ? (
            <>
              {" "}No café beneficiado, a área encolheu, e a produção cresceu porque a
              produtividade subiu.
            </>
          ) : null}{" "}
          Os números de cada período estão na figura.
        </p>
      )
    }
  </div>

  <figure id="figura-2" class="growth__figure" aria-labelledby="figura-2-titulo">
    <div class="growth__head">
      <h3 id="figura-2-titulo" class="growth__title">
        <Structural kind="figure" n={2} />. Quanto mudaram a produção, a área e a produtividade, Brasil
      </h3>
      <ul class="legend small" aria-label="Legenda da figura">
        {
          FACTORS.map((factor) => (
            <li>
              <span class={`legend__swatch growth__swatch--${factor.key}`} aria-hidden="true" />
              {factor.name}
            </li>
          ))
        }
      </ul>
    </div>
    <p class="growth__reading small">
      Variação em cada período, entre as médias de três anos nas pontas. À esquerda do zero, o
      que diminuiu.
    </p>

    <div class="growth__chart">
      {
        groups.map((group) => (
          <div class="growth__group">
            <h4 class="growth__crop">{group.name}</h4>
            {group.whole !== undefined && (
              <p class="growth__summary small">
                De <Num n={year(group.whole, "start_anchor")} /> a <Num n={year(group.whole, "end_anchor")} />:{" "}
                {FACTORS.map((factor, k) => (
                  <>
                    {k > 0 ? ", " : ""}
                    {factor.name} <Num n={change(group.whole!, factor.field)} />
                  </>
                ))}
                .
              </p>
            )}
            <ul class="growth__rows">
              {group.parts.map((row) => (
                <li class="growth__row">
                  <span class="growth__period meta">
                    <Num n={year(row, "start_anchor")} />–<Num n={year(row, "end_anchor")} />
                  </span>
                  <span class="growth__pair">
                    <span class="growth__zero" style={`left: ${x(0)}%`} aria-hidden="true" />
                    {FACTORS.map((factor) => {
                      const bar = barOf(row, factor.field);
                      return (
                        <span class="growth__line" data-factor={factor.key}>
                          <span
                            class={`growth__bar growth__bar--${factor.key}`}
                            style={`left: ${bar.left}%; width: ${bar.width}%`}
                            aria-hidden="true"
                          />
                          <span class="growth__value small" style={`left: ${bar.label}%`}>
                            {factor.name} <Num n={change(row, factor.field)} />
                          </span>
                        </span>
                      );
                    })}
                  </span>
                </li>
              ))}
            </ul>
            {group.id === "coffee_processed" && coffeeNote !== null && coffee !== undefined && (
              <p class="growth__note small">
                A área colhida de café diminuiu{coffeeNote.everyPeriod ? " em todos os períodos" : ""}, de{" "}
                <Num n={coffeeNote.from} /> hectares em <Num n={year(coffee, "start_anchor")} /> para{" "}
                <Num n={coffeeNote.to} /> em <Num n={year(coffee, "end_anchor")} />. A produção
                cresceu porque a produtividade subiu mais do que a área caiu.
              </p>
            )}
          </div>
        ))
      }
    </div>

    <figcaption class="growth__caption small">
      <p>
        <a href="/metodo/#fontes">Fonte</a>: IBGE, Produção Agrícola Municipal. Cada ponta de
        período é a média de três anos. O café começa depois da mudança de unidade de{" "}
        <Num n={breakYear} />. A parte de cada fator no crescimento (decomposição logarítmica)
        está na tabela.
      </p>
      <ul class="figure__links" aria-label="Links da figura">
        <li><a href={`${dataBasePath}/analysis.json`} type="application/json">Dados</a></li>
        <li><a href="/metodo/">Método</a></li>
        <li><a href="#figura-2">Link</a></li>
      </ul>
    </figcaption>

    <details class="growth__data">
      <summary class="small">Ver os dados da figura em tabela</summary>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Dados da figura em tabela">
        <table data-src-table={TABLE} data-src-cols={COLUMNS}>
          <caption class="small">
            <Structural kind="table" n={1} /> · Produção e área nas pontas de cada período e a parte de
            cada fator no crescimento, Brasil
          </caption>
          <thead>
            <tr>
              <th scope="col">Cultura</th>
              <th scope="col">Período</th>
              <th scope="col">Produção no início (t)</th>
              <th scope="col">Produção no fim (t)</th>
              <th scope="col">Área colhida no início (ha)</th>
              <th scope="col">Área colhida no fim (ha)</th>
              <th scope="col">Parte da área</th>
              <th scope="col">Parte da produtividade</th>
            </tr>
          </thead>
          <tbody>
            {
              groups.flatMap((group) =>
                [group.whole!, ...group.parts].map((row) => (
                  <tr data-row={row}>
                    <th scope="row">{group.name}</th>
                    <td class="num">
                      {format(at("start_anchor", row), "year")}–{format(at("end_anchor", row), "year")}
                    </td>
                    <td class="num">{format(at("start_production_t", row), "int")}</td>
                    <td class="num">{format(at("end_production_t", row), "int")}</td>
                    <td class="num">{format(at("start_harvested_area_ha", row), "int")}</td>
                    <td class="num">{format(at("end_harvested_area_ha", row), "int")}</td>
                    <td class="num">{format(at("area_share_of_growth", row), "pct")}</td>
                    <td class="num">{format(at("yield_share_of_growth", row), "pct")}</td>
                  </tr>
                )),
              )
            }
          </tbody>
        </table>
      </div>
    </details>
  </figure>
</section>
