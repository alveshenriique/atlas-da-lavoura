// The site on Cloudflare Workers: static assets only, no Worker code, so every response is a
// file of dist/ with the headers of dist/_headers (generated at build by
// scripts/make-headers.mjs). Deployed by .github/workflows/site.yml after the site checks pass
// on main; pull requests get a preview version (wrangler versions upload --preview-alias).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atlas-da-lavoura",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // A missing page answers 404 with dist/404.html.
    "not_found_handling": "404-page",
    // /explorar/ serves dist/explorar/index.html; /explorar redirects to /explorar/.
    "html_handling": "auto-trailing-slash"
  },
  // Production lives only on the custom domain; the workers.dev subdomain serves the preview
  // versions (Version URLs), which carry a noindex header (see _headers).
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "atlasdalavoura.com.br", "custom_domain": true }]
}
